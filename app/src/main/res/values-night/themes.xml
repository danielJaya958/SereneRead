<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Seluruh layar memakai warna terang (latar "kertas") yang di-hardcode di layout.
         Tanpa override ini, mode gelap jatuh ke warna ungu bawaan Material3. -->
    <style name="Base.Theme.MyApplication" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/deep_teal</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/soft_gold</item>
        <item name="colorOnSecondary">@color/charcoal_grey</item>

        <item name="android:colorBackground">@color/cream_white</item>
        <item name="colorOnBackground">@color/charcoal_grey</item>
        <item name="colorSurface">@color/pure_white</item>
        <item name="colorOnSurface">@color/charcoal_grey</item>

        <item name="android:statusBarColor">@color/cream_white</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
